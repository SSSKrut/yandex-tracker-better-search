# --- Yandex Tracker (needed to sync: the `serve` and `sync` commands) ---
# Auth: set either an OAuth token (long-lived) or an IAM token (short-lived,
# issued by Yandex Cloud). If both are set, IAM wins.
TRACKER_OAUTH_TOKEN="your_token"
# TRACKER_IAM_TOKEN="your_iam_token"
TRACKER_CLOUD_ORG_ID="your_org_id"   # or TRACKER_ORG_ID

# --- Manticore (the search backend) ---
MANTICORE_URL="http://localhost:9308"

# --- MCP HTTP transport ---
# Empty leaves the /mcp endpoint open. Fine for a loopback run; for a shared
# deployment set a secret that clients send as
# `Authorization: Bearer <token>`.
MCP_AUTH_TOKEN=""

# Optional. Durations use Go syntax: 30s, 10m, 1h30m.
# An unparseable value fails startup instead of silently becoming the default.
# ATTACHMENT_TEXT_MAX_BYTES=2097152
# SYNC_STATE_PATH=backups/sync_state.json
# SYNC_OVERLAP=2m
# MAP_CACHE_TTL=10m
